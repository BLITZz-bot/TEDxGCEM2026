NEXT_PUBLIC_SITE_URL=https://tedxgcem.in

# ─────────────────────────────────────────────────────────────────────────────
# Razorpay Payment Gateway
# Sign up at https://razorpay.com → Dashboard → Settings → API Keys
# Use rzp_test_* keys for local testing (no real money charged)
# Use rzp_live_* keys for production (real money)
# IMPORTANT: RAZORPAY_KEY_SECRET must NEVER be exposed to the browser.
# NEXT_PUBLIC_RAZORPAY_KEY_ID is safe to expose (public key).
# ─────────────────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxxxxxx

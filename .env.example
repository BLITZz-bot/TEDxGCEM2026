ADMIN_DELETE_PASSWORD=your_secure_admin_deletion_password

# Resend Automated Email Configuration (Domain: tedxgcem.in)
# Generate an API key at https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

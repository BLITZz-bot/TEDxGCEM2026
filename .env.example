# ═══════════════════════════════════════════════════════════════════════════════
# TEDxGCEM — Environment Variables
# ═══════════════════════════════════════════════════════════════════════════════
#
# SETUP: Copy this file to .env.local and fill in all required values.
#
#   cp .env.example .env.local
#
# SECURITY RULES:
#   - Variables prefixed with NEXT_PUBLIC_ are exposed to the browser bundle.
#     Only put NON-SECRET values here (e.g., public API keys, site URL).
#   - All other variables are server-side only and never reach the browser.
#   - NEVER commit .env.local to version control.
#
# ═══════════════════════════════════════════════════════════════════════════════


# ─── Supabase ─────────────────────────────────────────────────────────────────
# Your project URL and anonymous key from:
# Supabase Dashboard → Project Settings → API
# The anon key is safe to use on the server; it respects Row Level Security.

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key


# ─── Site ─────────────────────────────────────────────────────────────────────
# The canonical URL of the deployed website (no trailing slash).
# Used for SEO metadata, Open Graph, sitemap, and email links.

NEXT_PUBLIC_SITE_URL=https://tedxgcem.in


# ─── Admin Access ─────────────────────────────────────────────────────────────
# The Google account email that has admin privileges.
# Must match exactly (case-insensitive comparison is applied at runtime).

ADMIN_EMAIL=tedxgcem@gmail.com

# Password required for irreversible admin operations (e.g., deleting a
# registration). Set a long, random string. Keep this secret.

ADMIN_DELETE_PASSWORD=your_secure_admin_deletion_password


# ─── Email (Resend) ───────────────────────────────────────────────────────────
# Transactional email for ticket confirmation emails.
# Get an API key at: https://resend.com → API Keys
# The FROM address must match a verified domain in your Resend account.

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=team@tedxgcem.in


# ─── Direct UPI Payment & Mobile Handoff ──────────────────────────────────────
# The official UPI VPA and Merchant Name for Direct UPI QR payments
NEXT_PUBLIC_UPI_ID=tedxgcem@okhdfcbank
NEXT_PUBLIC_UPI_NAME=TEDxGCEM 2026


# ─── Cloudflare Turnstile (Bot & Abuse Protection) ───────────────────────────
# Get keys at: https://dash.cloudflare.com → Turnstile
# NEXT_PUBLIC_TURNSTILE_SITE_KEY: Safe for browser bundle
# TURNSTILE_SECRET_KEY: Server-side only (never expose)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAA...
TURNSTILE_SECRET_KEY=0x4AAAAAA...

